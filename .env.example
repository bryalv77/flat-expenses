EXPO_PUBLIC_FIREBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=xxxxxx.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=xxxxx
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=xxxxx-xxxxx.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=xxxxxx
EXPO_PUBLIC_FIREBASE_APP_ID=1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=xxxxxx

# Set to true to use the local Auth / Firestore / Storage emulators
EXPO_PUBLIC_USE_EMULATORS=false
# Host of the emulators (use your LAN IP when testing on a physical device; 10.0.2.2 on Android emulator)
EXPO_PUBLIC_EMULATOR_HOST=localhost

# Feature flags for social sign-in (need native build config / OAuth client ids)
EXPO_PUBLIC_ENABLE_GOOGLE_SIGNIN=false
EXPO_PUBLIC_ENABLE_APPLE_SIGNIN=false
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# App Check (web). reCAPTCHA Enterprise site key from Firebase console > App Check > Apps > Web.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
