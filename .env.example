# Cloudflare Worker API (Neon Postgres + R2 + Better Auth). Leave empty to run in local mode only (data stays on the device).
# Inlined at bundle time, so changing it needs a new web export / build / EAS Update.
EXPO_PUBLIC_API_URL=
# Where password-reset emails send people; the default is the hosted web app.
EXPO_PUBLIC_WEB_URL=
