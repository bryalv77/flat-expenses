{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "costos-piso-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Create once with `wrangler r2 bucket create costos-piso-files`. `wrangler dev` simulates it locally.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "costos-piso-files" }],
  "env": { "local": { "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "costos-piso-files" }] } } // bindings are not inherited by envs; `pnpm dev:local` reads .dev.vars.local (native Postgres)
  // Secrets (never committed): wrangler secret put DATABASE_URL | BETTER_AUTH_SECRET
}
