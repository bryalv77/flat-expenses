{
  "cli": {
    "version": ">= 24.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://costos-piso-api.bryalv77.workers.dev"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://costos-piso-api.bryalv77.workers.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6834542662" }
    }
  }
}
