{
  "expo": {
    "name": "Costos Piso",
    "slug": "costos-piso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "costospiso",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.costospiso.app",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Costos Piso usa la cámara para fotografiar facturas y documentos.",
        "NSPhotoLibraryUsageDescription": "Costos Piso accede a tus fotos para adjuntar facturas, documentos y tu foto de perfil.",
        "NSPhotoLibraryAddUsageDescription": "Costos Piso guarda imágenes en tu fototeca cuando lo pides."
      }
    },
    "android": {
      "package": "com.costospiso.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Costos Piso accede a tus fotos para adjuntar facturas, documentos y tu foto de perfil.",
          "cameraPermission": "Costos Piso usa la cámara para fotografiar facturas y documentos.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c0e525f7-8798-47ac-951a-d180768d0ce3"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0e525f7-8798-47ac-951a-d180768d0ce3"
      }
    },
    "owner": "bryalv77"
  }
}
