{
  "expo": {
    "name": "Cuota",
    "slug": "costos-piso",
    "version": "1.3.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "costospiso",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.devalv.costospiso",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Cuota usa la cámara para fotografiar facturas y documentos.",
        "NSPhotoLibraryUsageDescription": "Cuota accede a tus fotos para adjuntar facturas, documentos y tu foto de perfil.",
        "NSPhotoLibraryAddUsageDescription": "Cuota guarda imágenes en tu fototeca cuando lo pides."
      }
    },
    "android": {
      "package": "com.costospiso.app",
      "adaptiveIcon": {
        "backgroundColor": "#1479F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cuota accede a tus fotos para adjuntar facturas, documentos y tu foto de perfil.",
          "cameraPermission": "Cuota usa la cámara para fotografiar facturas y documentos.",
          "microphonePermission": false
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-sqlite",
      "./plugins/withExcludeLocalDataFromBackup"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/c0e525f7-8798-47ac-951a-d180768d0ce3"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c0e525f7-8798-47ac-951a-d180768d0ce3"
      }
    },
    "owner": "bryalv77"
  }
}
